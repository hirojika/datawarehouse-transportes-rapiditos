<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>03_hechos</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Valida las transacciones, busca las llaves sustitutas y carga fact_venta</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/18 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/18 00:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>Etapas 4 y 6: la vista stg.v_transaccion_conformada convierte a CLP, km y kg
y calcula el motivo de rechazo. Las filas válidas buscan sus llaves sustitutas
y se cargan en fact_venta; el resto queda en stg.rechazo. Ambas tablas se vacían
al inicio, así que el pipeline se puede repetir solo.</note>
      <xloc>112</xloc>
      <yloc>16</yloc>
      <width>560</width>
      <heigth>76</heigth>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Leer transacciones conformadas</from>
      <to>¿Cumple las reglas?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>¿Cumple las reglas?</from>
      <to>Buscar id_cliente</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>¿Cumple las reglas?</from>
      <to>Registrar rechazo</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Buscar id_cliente</from>
      <to>Buscar id_servicio</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Buscar id_servicio</from>
      <to>Buscar id_zona_origen</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Buscar id_zona_origen</from>
      <to>Buscar id_zona_destino</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Buscar id_zona_destino</from>
      <to>Buscar id_canal_venta</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Buscar id_canal_venta</from>
      <to>Buscar id_medio_pago</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Buscar id_medio_pago</from>
      <to>Cargar fact_venta</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Leer transacciones conformadas</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>rapiditos</connection>
    <sql>SELECT *
FROM stg.v_transaccion_conformada
ORDER BY numero_transaccion</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>¿Cumple las reglas?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Buscar id_cliente</send_true_to>
    <send_false_to>Registrar rechazo</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>motivo_rechazo</leftvalue>
        <function>IS NULL</function>
        <rightvalue/>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>336</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Registrar rechazo</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>rapiditos</connection>
    <schema>stg</schema>
    <table>rechazo</table>
    <fields>
      <field>
        <column_name>numero_transaccion</column_name>
        <stream_name>numero_transaccion</stream_name>
      </field>
      <field>
        <column_name>codigo_linea</column_name>
        <stream_name>codigo_linea</stream_name>
      </field>
      <field>
        <column_name>motivo</column_name>
        <stream_name>motivo_rechazo</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>N</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>Y</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>336</xloc>
      <yloc>368</yloc>
    </GUI>
  </transform>
