# Conexión a PostgreSQL (servicio "postgres" de docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rapiditos
DB_USER=rapiditos
DB_PASSWORD=cambiar_esta_clave
# Base temporal que pytest crea y borra para probar sql/01_ddl.sql (nunca DB_NAME)
DB_NAME_TEST=rapiditos_test

# pgAdmin (http://localhost:5050). El correo debe tener formato válido.
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@rapiditos.cl
PGADMIN_PASSWORD=cambiar_esta_clave
